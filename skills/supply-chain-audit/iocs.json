      "date": "YYYY-MM-DD disclosure date",
      "attribution": "attacker group or null",
      "attack_windows_utc": "array of {start, end} ISO 8601 UTC strings — when malicious versions were live",
      "compromised_scopes": "array of npm scopes whose packages are at risk (e.g. @tanstack)",
      "compromised_packages": "array of unscoped package names",
      "compromised_pypi": "array of PyPI package names",
      "payload_files": "filenames the malware drops or smuggles into tarballs",
      "payload_hashes_sha256": "object {filename: sha256}",
      "string_iocs": "free-text strings to grep for in lockfiles, source, configs",
      "optional_dependency_iocs": "prefixes that, if found in an optionalDependencies value, signal compromise",
      "persistence": "object {macos: [], linux: [], windows: [], shared: []} of paths to check",
      "references": "URLs to disclosures / postmortems"
    }
  },
